NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-your-supabase-anon-or-publishable-key

# --- Phase 3.8: Backend URL ---
# Override the per-environment default in frontend/lib/api/backend.ts.
# - Local dev defaults to http://localhost:8080 (when NODE_ENV !== 'production')
# - Production defaults to https://rentguardai.onrender.com (when NODE_ENV === 'production')
# Setting this env var only matters if you want to point at a different host
# (e.g. a staging backend or a tunnel from a coworker's machine).
# NEXT_PUBLIC_BACKEND_URL=http://localhost:8080
