# RentGuard backend env vars (Phase 1.1 — only the basics; later phases add more)
# Copy this file to `.env` for local development. Never commit `.env`.

# Node runtime
NODE_ENV=development
PORT=8080
LOG_LEVEL=info

# Git commit SHA — set automatically by Render (RENDER_GIT_COMMIT). For local dev,
# the server will fall back to `git rev-parse HEAD`. Override here if needed.
# GIT_COMMIT_SHA=
