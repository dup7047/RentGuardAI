# RentGuard backend env vars. Copy to `.env` for local development.
# Never commit `.env` — only `.env.example` is tracked.

# --- Node runtime ---
NODE_ENV=development
PORT=8080
LOG_LEVEL=info

# --- Database ---
# Local Supabase stack started by `supabase start` from the repo root listens on
# port 54322 with these default credentials. For staging/prod, paste the
# connection string from the Supabase project's Settings → Database page.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Git commit SHA — set automatically by Render (RENDER_GIT_COMMIT). For local
# dev, the server will fall back to `git rev-parse HEAD`. Override here if needed.
# GIT_COMMIT_SHA=

# --- Phase 0.3: NYC Open Data ---
# Public app token from https://data.cityofnewyork.us/profile/edit/developer_settings.
# Without it, ingestion still works but is rate-limited to ~1k req/hr (shared).
# With it: ~10k req/hr per token. See docs/nyc-open-data-token.md for setup.
NYC_OPEN_DATA_APP_TOKEN=

# --- Phase 0.4: Stripe ---
# Test-mode API keys from https://dashboard.stripe.com/test/apikeys.
# All Phase-0 work uses test mode only; the setup script refuses to run with sk_live_…
STRIPE_SECRET_KEY=sk_test_REPLACE_ME

# Webhook signing secret from Dashboard → Developers → Webhooks → click endpoint.
# Used by the backend to verify Stripe webhook signatures.
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME

# Optional: override the URL the webhook endpoint points to. Defaults to the
# Render staging URL when running scripts/stripe-setup.ts.
# STRIPE_WEBHOOK_URL=https://rentguard-backend.onrender.com/webhooks/stripe

# Price IDs — output by `npm run stripe:setup` after the script creates them.
# These are stable IDs you reference from Checkout sessions.
STRIPE_LEASE_REVIEW_PRICE_ID=price_REPLACE_ME
STRIPE_SEARCH_PASS_PRICE_ID=price_REPLACE_ME

# Customer Portal configuration ID — output by `npm run stripe:setup`.
STRIPE_PORTAL_CONFIG_ID=bpc_REPLACE_ME

# --- Phase 3.7: OpenAI ---
# https://platform.openai.com/api-keys; Chat Completions; model gpt-4o-mini.
# Pricing (Nov 2024): $0.15/M input, $0.60/M output. Budget caps enforced in 3.7b.
OPENAI_API_KEY=sk-REPLACE_ME

# --- Phase 3.8: Auth ---
# Supabase JWT secret (Project Settings → API → JWT secret).
# Local dev default matches supabase/config.toml.
SUPABASE_JWT_SECRET=super-secret-jwt-token-with-at-least-32-characters-long

# Supabase project URL (Project Settings → API → Project URL).
# Used to validate the `iss` claim on incoming JWTs. Required.
# Local dev default points at the local Supabase stack.
SUPABASE_URL=http://127.0.0.1:54321

# --- Phase 3.9: Beehiiv (waitlist enrollment) ---
# https://app.beehiiv.com/settings/integrations/api
# Stub-able locally: if missing, /v1/waitlist/email logs the attempt and returns 200.
BEEHIIV_API_KEY=
BEEHIIV_PUBLICATION_ID=

# --- Email forwarding (Cloudflare Email Routing) ---
# API token from https://dash.cloudflare.com/profile/api-tokens
# Permission needed: Zone → Email Routing Rules → Edit (scoped to rentguard.cc)
# Run `npm run email:forwarding` after completing DNS setup (see docs/email-forwarding.md).
CLOUDFLARE_API_TOKEN=
# Destination inbox for forwarded mail (required by `npm run email:forwarding`).
# Must be verified in Cloudflare: Dashboard → Email → Email Routing → Destination addresses.
FORWARD_TO_EMAIL=

# --- Phase 4: Firecrawl (listing scraping fallback) ---
# Free tier: 500 credits one-time at https://www.firecrawl.dev.
# Optional — without it, the fetcher returns `kind: 'listing_blocked'`
# for sites with bot protection (StreetEasy, Zillow). Direct fetch still
# works for sites without protection. Slug-parse fallback (in code) recovers
# the address from Zillow/StreetEasy URLs when the scraper is unavailable.
FIRECRAWL_API_KEY=
# Optional — override the threshold for the "usage above 80%" startup warning.
# Defaults to 500 (free-tier size). Bump after upgrading to a paid Firecrawl plan.
# FIRECRAWL_FREE_TIER_CREDITS=3000
