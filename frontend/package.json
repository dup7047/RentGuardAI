{
  "name": "@rentguard/frontend",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "tsx scripts/build-disclaimers.ts && next dev",
    "build": "tsx scripts/build-disclaimers.ts && next build",
    "start": "next start",
    "lint": "next lint",
    "test": "tsx scripts/build-disclaimers.ts && vitest run",
    "test:watch": "tsx scripts/build-disclaimers.ts && vitest",
    "build:disclaimers": "tsx scripts/build-disclaimers.ts",
    "e2e": "playwright test",
    "e2e:smoke": "playwright test --grep @smoke --project=chromium-desktop --project=webkit-desktop",
    "e2e:full": "playwright test",
    "e2e:staging": "playwright test --grep @staging"
  },
  "dependencies": {
    "@supabase/ssr": "^0.10.2",
    "@supabase/supabase-js": "^2.105.3",
    "next": "^15.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^9.0.1",
    "remark-gfm": "^4.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@playwright/test": "^1.59.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.1",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.7.0",
    "happy-dom": "^20.9.0",
    "tsx": "^4.21.0",
    "typescript": "^5.7.2",
    "vitest": "^2.1.9"
  },
  "overrides": {
    "postcss": "^8.5.10"
  }
}
