# RentGuard backend env vars. Copy to `.env` for local development.
# Never commit `.env` — only `.env.example` is tracked.

# Node runtime
NODE_ENV=development
PORT=8080
LOG_LEVEL=info

# Database — local Supabase stack started by `supabase start` from the repo root
# listens on port 54322 with these default credentials. For staging/prod, paste
# the connection string from the Supabase project's Settings → Database page.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Git commit SHA — set automatically by Render (RENDER_GIT_COMMIT). For local dev,
# the server will fall back to `git rev-parse HEAD`. Override here if needed.
# GIT_COMMIT_SHA=
